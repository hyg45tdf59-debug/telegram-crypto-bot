# Telegram Bot Configuration
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Cryptocurrency API Configuration
# Using CoinGecko (no key required for basic usage)
# Optional: CoinGecko Pro API key
VITE_CRYPTO_API_KEY=your_coingecko_api_key_here

# Exchange API Configuration (if integrating with exchanges)
# Example: Binance, Kraken, Coinbase
VITE_EXCHANGE_API_KEY=your_exchange_api_key_here
VITE_EXCHANGE_API_SECRET=your_exchange_api_secret_here

# Wallet Configuration (for actual trading)
# NEVER commit real private keys!
# Use a key management service in production
VITE_WALLET_PRIVATE_KEY=your_wallet_private_key_here
VITE_WALLET_MNEMONIC=your_wallet_mnemonic_phrase_here
VITE_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Database Configuration
DATABASE_URL=mongodb://username:password@localhost:27017/crypto-bot
DATABASE_NAME=crypto-bot

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_RATE_LIMIT=100

# Feature Flags
VITE_ENABLE_REAL_TRADING=false
VITE_ENABLE_ANALYTICS=true
VITE_ENVIRONMENT=development

# Logging
VITE_LOG_LEVEL=info

# Security
VITE_SESSION_TIMEOUT=3600000
VITE_ENCRYPTION_KEY=your_encryption_key_here
